import { FC, useState, useEffect } from "react";
import { Box, Text } from "@mantine/core";
import GoogleIcon from "@/assets/icons/google";
import Logo from "@/assets/logo.svg";
import CenterImg1 from "@/assets/center1.jpg";
import CenterImg2 from "@/assets/center3.png";
import CenterImg3 from "@/assets/center2.jpg";

const slides = [CenterImg1, CenterImg2, CenterImg3];

const styles = {
  container: {
    position: "relative",
    height: "100%",
    width: "100%",
    overflow: "hidden",
    background:
      "linear-gradient(135deg, var(--light-100) 0%, var(--light-100) 50%, var(--light-100) 100%)",
    padding: "25px 20px 20px 20px",
    display: "flex",
    flexDirection: "column",
    alignItems: "center",
    justifyContent: "space-between",
  },
  noiseOverlay: {
    position: "absolute",
    top: 0,
    left: 0,
    width: "100%",
    height: "100%",
    zIndex: 0,
    pointerEvents: "none",
    filter: "url(#noiseFilter)",
    opacity: 0.2,
  },
  topBar: {
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    gap: 10,
    marginBottom: -20
  },
  logoText: {
    fontSize: 16,
    fontWeight: 600,
    color: "var(---dark-100)",
  },
  centerWrapper: {
    display: "flex",
    flexDirection: "column",
    alignItems: "center",
    justifyContent: "center",
    gap: 16,
    marginTop: 20,
  },
  centerImages: {
    width: 350,
    height: 350,
    borderRadius: 25,
    overflow: "hidden"
  },
  centerImg: {
    width: "100%",
    height: "100%",
    objectPosition: "center",
    objectFit: "cover",
  },
  dotsWrapper: {
    display: "flex",
    gap: 6,
  },
  dot: {
    height: 6,
    borderRadius: 10,
    backgroundColor: "var(--dark-400)",
    transition: "all 0.3s ease",
  },
  activeDot: {
    width: 20,
    backgroundColor: "var(--dark-100)",
  },
  inactiveDot: {
    width: 6,
  },
  bottomWrapper: {
    display: "flex",
    flexDirection: "column",
    gap: 5,
    width: "100%"
  },
  title: {
    fontSize: 25,
    fontWeight: 600,
    color: "var(--dark-100)",
    textAlign: "center",
    lineHeight: 1.4,
    marginBottom: 15
  },
  primaryBtn: {
    width: "100%",
    height: 48,
    borderRadius: 15,
    backgroundColor: "var(--light-200)",
    color: "var(--dark-100)",
    fontSize: 14,
    fontWeight: 650,
    display: "flex",
    justifyContent: "center",
    alignItems: "center",
  },
  primaryText: {
    fontSize: 14,
    fontWeight: 500,
    marginLeft: 8,
  },
  linkText: {
    fontSize: 13,
    fontWeight: 550,
    color: "var(--dark-200)",
    textAlign: "center",
    marginTop: 10,
  },
  linkSpan: {
    color: "var(--dark-100)",
    textDecorationLine: "underline",
    textDecorationThickness: "1px",
    textUnderlineOffset: "2px",
    textDecorationColor: "var(--dark-100)",
    cursor: "pointer"
  },
} as const;

const Navigate: FC = () => {
  const [active, setActive] = useState(0);

  useEffect(() => {
    const interval = setInterval(() => {
      setActive((prev) => (prev + 1) % slides.length);
    }, 3000);

    return () => clearInterval(interval);
  }, []);

  return (
    <Box style={styles.container}>
      <svg style={{ display: "none" }}>
        <filter id="noiseFilter">
          <feTurbulence type="fractalNoise" baseFrequency="0.6" stitchTiles="stitch" />
        </filter>
      </svg>
      <Box style={styles.noiseOverlay} />

      <Box style={styles.topBar}>
        <img src={Logo} alt="logo" width={25} />
        <Text style={styles.logoText}>Cruza</Text>
      </Box>

      <Box style={styles.centerWrapper}>
        <Box style={styles.centerImages}><img src={slides[active]} alt="center" style={styles.centerImg}/></Box>

        <Box style={styles.dotsWrapper}>
          {slides.map((_, index) => (
            <Box
              key={index}
              style={{
                ...styles.dot,
                ...(active === index
                  ? styles.activeDot
                  : styles.inactiveDot),
              }}
            />
          ))}
        </Box>
      </Box>

      <Box style={styles.bottomWrapper}>
        <Text style={styles.title}>Your next trip starts here!</Text>

        <Box style={styles.primaryBtn}>
          <GoogleIcon width={16} height={16} />
          <Text style={styles.primaryText}>
            Continue with Google
          </Text>
        </Box>

        <Text style={styles.linkText}>Already have an account? <span style={styles.linkSpan}>Sign in</span></Text>
      </Box>
    </Box>
  );
};

export default Navigate;